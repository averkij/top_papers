        "header": "3Method",
        "images": [
            {
                "img": "https://arxiv.org/html/2610.12611/2610.12611v1/software_synthesis_pipeline.png",
                "caption": "Figure 2:SoftwareGym synthesizes diverse, reliable, and executable applications\nthrough design, implementation, and evaluation. Design produces rich functional\nspecifications and distinct interfaces. Implementation realizes and verifies\nthe applications. Evaluation tests their GUI behavior and returns failures for\nsubsequent implementation repair.",
                "position": 532
            },
            {
                "img": "https://arxiv.org/html/2610.12611/2610.12611v1/task_synthesis_flownote.png",
                "caption": "Figure 3:SoftwareGym grounds every synthesized task in capabilities\nverified through GUI interaction. It first extracts evidence-supported\ncapabilities, then assigns coherent combinations to difficulty- and\nstate-controlled slots, and finally realizes each slot as a natural request\nwith an explicit initial state and expected outcome.",
                "position": 659
            }
        ]
    },
