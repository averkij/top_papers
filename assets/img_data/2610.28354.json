        "header": "2Method",
        "images": [
            {
                "img": "https://arxiv.org/html/2610.28354/2610.28354v1/framework.png",
                "caption": "Figure 2:Overview of the framework. The agent keeps a coding agent’s\nfull generic freedom over the workspace (viewing images, reading and writing\nfiles, writing and running code) and composes perception through the same\nshell; the toolkit registers everything it perceives into the scene memory\nand returns interpreted, answer-ready readings.",
                "position": 463
            },
            {
                "img": "https://arxiv.org/html/2610.28354/2610.28354v1/method_example.png",
                "caption": "Figure 3:An example question used throughout this section. Left to right: the question, the agent’s\ncommand sequence colour-coded by who performs the perception, the\noutputs those calls produce and the scene memory they write, and the\nreadouts that answer the question.",
                "position": 565
            }
